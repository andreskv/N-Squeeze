# Copy to .env and fill in. Never commit .env.
# Keys are free. Register early: some approvals take days.

AGSI_API_KEY=          # https://agsi.gie.eu  (also used for ALSI+)
EIA_API_KEY=           # https://www.eia.gov/opendata/register.php
AISSTREAM_API_KEY=     # https://aisstream.io
ENTSOE_TOKEN=          # https://transparency.entsoe.eu  (request via account settings)
CDS_API_KEY=           # https://cds.climate.copernicus.eu  (ERA5)
GEE_PROJECT=           # Google Cloud project ID registered for Earth Engine (Phase 3). Auth: run `earthengine authenticate` yourself

# Optional overrides
# NSQ_CONFIG_DIR=./config
# NSQ_DATA_DIR=./data
